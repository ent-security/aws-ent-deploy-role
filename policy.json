            ],
            "Resource": "arn:aws:resource-groups:*:*:group/e???????????????-*"
        },
        {
            "Sid": "Route53Access",
            "Effect": "Allow",
            "Action": [
                "route53:*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "S3Access",
            "Effect": "Allow",
            "Action": [
                "s3:*"
            ],
            "Resource": [
                "arn:aws:s3:::e???????????????-*",
                "arn:aws:s3:::e???????????????-*/*"
            ]
