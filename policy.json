                "cloudwatch:*"
            ],
            "Resource": [
                "arn:aws:cloudwatch:*:*:alarm:e???????????????-*"
            ]
        },
        {
            "Sid": "EC2Access",
            "Effect": "Allow",
            "Action": [
                "ec2:*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "ECRAccess",
            "Effect": "Allow",
            "Action": [
                "ecr:*"
            ],
            "Resource": "arn:aws:ecr:*:*:repository/e???????????????-*"
