                "logs:DescribeLogStreams"
            ],
            "Resource": "*"
        },
        {
            "Sid": "RDSAccess",
            "Effect": "Allow",
            "Action": [
                "rds:*",
                "rds-db:*"
            ],
            "Resource": [
                "arn:aws:rds:*:*:db:e???????????????-*",
                "arn:aws:rds:*:*:cluster:e???????????????-*",
                "arn:aws:rds:*:*:pg:e???????????????-*",
                "arn:aws:rds:*:*:subgrp:e???????????????-*",
                "arn:aws:rds:*:*:es:e???????????????-*",
                "arn:aws:rds-db:*:*:dbuser:*/*"
