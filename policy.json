{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "CertificateManagerAccess",
            "Effect": "Allow",
            "Action": [
                "acm:*"
            ],
            "Resource": "*"
        },
        {
            "Sid": "AthenaAccess",
            "Effect": "Allow",
            "Action": [
                "athena:*"
            ],
            "Resource": [
                "arn:aws:athena:*:*:workgroup/e???????????????-*",
                "arn:aws:athena:*:*:datacatalog/e???????????????-*"
            ]
        },
        {
            "Sid": "BedrockAccess",
            "Effect": "Allow",
            "Action": [
                "bedrock:*"
            ],
