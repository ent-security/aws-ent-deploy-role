        {
            "Sid": "EKSAccess",
            "Effect": "Allow",
            "Action": [
                "eks:*"
            ],
            "Resource": [
                "arn:aws:eks:*:*:cluster/e???????????????-*",
                "arn:aws:eks:*:*:nodegroup/e???????????????-*/*/*",
                "arn:aws:eks:*:*:access-entry/e???????????????-*/*",
                "arn:aws:eks:*:*:addon/e???????????????-*/*/*"
            ]
        },
        {
            "Sid": "ElastiCacheAccess",
            "Effect": "Allow",
            "Action": [
                "elasticache:*"
            ],
            "Resource": [
                "arn:aws:elasticache:*:*:replicationgroup:e???????????????-*",
                "arn:aws:elasticache:*:*:parametergroup:e???????????????-*",
                "arn:aws:elasticache:*:*:subnetgroup:e???????????????-*"
