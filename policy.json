        {
            "Sid": "SNSAccess",
            "Effect": "Allow",
            "Action": [
                "sns:*"
            ],
            "Resource": [
                "arn:aws:sns:*:*:e???????????????-*",
                "arn:aws:sns:*:*:db-event-notifications"
