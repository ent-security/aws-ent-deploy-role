{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "IAMOwnerTagEnforcement",
            "Effect": "Deny",
            "Action": "iam:CreateRole",
            "Resource": "arn:aws:iam::*:role/e???????????????-*",
            "Condition": {
                "StringNotEquals": {
                    "aws:RequestTag/<OWNER_TAG_KEY>": "<OWNER_TAG_VALUE>"
                }
            }
        },
        {
            "Sid": "IAMOwnerTagValueProtection",
            "Effect": "Deny",
            "Action": "iam:TagRole",
            "Resource": "arn:aws:iam::*:role/e???????????????-*",
            "Condition": {
                "ForAnyValue:StringEqualsIgnoreCase": {
                    "aws:TagKeys": "<OWNER_TAG_KEY>"
                },
                "StringNotEquals": {
                    "aws:RequestTag/<OWNER_TAG_KEY>": "<OWNER_TAG_VALUE>"
                }
            }
        },
        {
            "Sid": "IAMOwnerTagRemovalProtection",
            "Effect": "Deny",
            "Action": "iam:UntagRole",
            "Resource": "arn:aws:iam::*:role/e???????????????-*",
            "Condition": {
                "ForAnyValue:StringEqualsIgnoreCase": {
                    "aws:TagKeys": "<OWNER_TAG_KEY>"
                }
            }
        }
    ]
}
