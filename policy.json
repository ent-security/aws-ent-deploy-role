                "arn:aws:logs:*:*:log-group:e???????????????-*:*",
                "arn:aws:logs:*:*:log-group:/aws/*/e???????????????-*",
                "arn:aws:logs:*:*:log-group:/aws/*/e???????????????-*:*",
                "arn:aws:logs:*:*:log-group:/????????-????-????-????-????????????/*",
                "arn:aws:logs:*:*:log-group:/????????-????-????-????-????????????/*:*"
            ]
        },
        {
            "Sid": "CloudWatchLogsDescribeAccess",
            "Effect": "Allow",
