        },
        {
            "Sid": "SQSAccess",
            "Effect": "Allow",
            "Action": [
                "sqs:*"
            ],
            "Resource": "arn:aws:sqs:*:*:e???????????????-*"
        },
        {
            "Sid": "STSAssumeRoleAccess",
            "Effect": "Allow",
            "Action": [
                "sts:AssumeRole",
                "sts:TagSession",
                "sts:AssumeRoleWithWebIdentity"
            ],
            "Resource": "arn:aws:iam::*:role/e???????????????-*"
